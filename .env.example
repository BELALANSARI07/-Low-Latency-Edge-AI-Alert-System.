# ==============================================================================
# LOW-LATENCY EDGE AI ALERT SYSTEM - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and configure for your deployment target.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Environment & Operational Mode
# ------------------------------------------------------------------------------
# APP_ENV: Options: development, test, staging, production
APP_ENV=development

# SIMULATION_MODE:
# Set to 'true' for local development without hardware cameras or ONNX GPU runtimes.
# Set to 'false' in production. Fake detections will NEVER be emitted when false.
SIMULATION_MODE=true

# FAIL_ON_MISSING_MODEL:
# If true, service aborts startup immediately if the configured ONNX model is missing/invalid.
FAIL_ON_MISSING_MODEL=false

# ------------------------------------------------------------------------------
# 2. Hardware Identification & Platform
# ------------------------------------------------------------------------------
DEVICE_NAME=jetson-nano-edge-01
HARDWARE_PLATFORM=jetson_nano  # Options: jetson_nano, rpi4, x86_simulated

# ------------------------------------------------------------------------------
# 3. Camera & Video Acquisition
# ------------------------------------------------------------------------------
CAMERA_ID=CAMERA_01 // HIGHWAY_CAM
# CAMERA_SOURCE:
# - 'synthetic' : Synthetic 60 FPS urban road scene with moving entities.
# - '0'         : Local USB / V4L2 web camera.
# - 'nvarguscamerasrc ! ...' : Jetson CSI-2 GStreamer pipeline string.
# - 'rtsp://user:pass@192.168.1.100:554/stream1' : IP Security camera feed.
CAMERA_SOURCE=synthetic
CAMERA_WIDTH=640
CAMERA_HEIGHT=640
CAMERA_FPS=60
CAMERA_RECONNECT_INTERVAL_SEC=2.0
CAMERA_MAX_RECONNECT_DELAY_SEC=30.0

# ------------------------------------------------------------------------------
# 4. Neural Network & ONNX Inference Engine
# ------------------------------------------------------------------------------
MODEL_PATH=models/yolov8n-fp16.onnx
MODEL_NAME=yolov8n
MODEL_VERSION=1.0.0
# MODEL_SHA256: Optional SHA-256 checksum to verify model file integrity on startup.
MODEL_SHA256=
# QUANTIZATION_MODE: FP32, FP16, or INT8
QUANTIZATION_MODE=FP16
# EXECUTION_PROVIDER:
# - CPUExecutionProvider       : Default portable CPU execution
# - CUDAExecutionProvider      : NVIDIA GPU acceleration via CUDA
# - TensorrtExecutionProvider  : NVIDIA TensorRT high-speed inference engine
EXECUTION_PROVIDER=CPUExecutionProvider
CONFIDENCE_THRESHOLD=0.70
IOU_THRESHOLD=0.45
MAX_DETECTIONS=25

# ------------------------------------------------------------------------------
# 5. Alert Engine & Physical Actuators
# ------------------------------------------------------------------------------
ALERT_CONFIDENCE_THRESHOLD=0.85
ALERT_COOLDOWN_SECONDS=2.0
# GPIO_ALERT_PIN: Physical pin 12 (BCM 18) connected to optocoupler relay board
GPIO_ALERT_PIN=18
# GPIO_PULSE_DURATION_MS: Milliseconds to hold GPIO HIGH before automatic reset to LOW
GPIO_PULSE_DURATION_MS=1500
# ENABLE_GPIO_ACTUATION: Must be explicitly 'true' to toggle physical hardware pins
ENABLE_GPIO_ACTUATION=false

# ------------------------------------------------------------------------------
# 6. Mosquitto MQTT Telemetry & Alert Bus
# ------------------------------------------------------------------------------
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_USE_TLS=false
MQTT_CA_CERT=
MQTT_CLIENT_CERT=
MQTT_CLIENT_KEY=
MQTT_ALERT_TOPIC=alert/system/01
MQTT_TELEMETRY_TOPIC=telemetry/edge/01
MQTT_CLIENT_ID=edge-detector-core-01
MQTT_QOS=1  # 0: At most once, 1: At least once, 2: Exactly once

# ------------------------------------------------------------------------------
# 7. FastAPI Service & Security Controls
# ------------------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
# API_KEY: Required secret header (X-API-Key) to invoke actuator and management endpoints
API_KEY=your-secret-edge-api-key-here
# ALLOWED_ORIGINS: Comma-separated domains for CORS
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
LOG_LEVEL=INFO
LOG_FORMAT=%(asctime)s [%(levelname)s] [%(name)s]: %(message)s

# ------------------------------------------------------------------------------
# 8. Alert History Persistence
# ------------------------------------------------------------------------------
ENABLE_ALERT_PERSISTENCE=false
ALERT_DB_PATH=telemetry_data/alerts.db
ALERT_RETENTION_DAYS=30
