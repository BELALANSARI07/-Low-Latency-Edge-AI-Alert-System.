# Edge Device Environment Configuration
DEVICE_NAME=jetson-nano-edge-01
HARDWARE_PLATFORM=jetson_nano  # Options: jetson_nano, rpi4, x86_simulated

# Camera Stream Configuration
CAMERA_ID=CAMERA_01
CAMERA_SOURCE=0  # Device index (0), RTSP URL (rtsp://...), or 'synthetic' for mock simulation
CAMERA_WIDTH=640
CAMERA_HEIGHT=640
CAMERA_FPS=60

# Model & Inference Engine
MODEL_PATH=models/yolov8n-fp16.onnx
QUANTIZATION_MODE=FP16  # Options: FP32, FP16, INT8
EXECUTION_PROVIDER=CPU  # Options: CUDA, TensorrtExecutionProvider, CPUExecutionProvider
CONFIDENCE_THRESHOLD=0.70
IOU_THRESHOLD=0.45
MAX_DETECTIONS=25

# Alert & Actuator Thresholds
ALERT_CONFIDENCE_THRESHOLD=0.85
ALERT_COOLDOWN_SECONDS=2.0
GPIO_ALERT_PIN=18
ENABLE_GPIO_ACTUATION=false  # Set true on physical Jetson / Raspberry Pi hardware

# MQTT Mosquitto Broker Bus
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
MQTT_ALERT_TOPIC=alert/system/01
MQTT_TELEMETRY_TOPIC=telemetry/edge/01
MQTT_CLIENT_ID=edge-detector-core-01
MQTT_QOS=1

# API & Telemetry Server
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO
